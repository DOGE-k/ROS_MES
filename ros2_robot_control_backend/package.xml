<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_control_backend</name>
  <version>0.0.0</version>
  <description>ROS2 robot control backend for ROS MES (CAN ID V2)</description>

  <maintainer email="yang@todo.todo">yang</maintainer>
  <license>TODO</license>

  <!-- ROS2 构建工具 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 消息生成 -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- 运行依赖（节点实际用到的只有 rclpy 和 std_msgs） -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- 以下为 pip 包，不是 rosdep 项，需手动 pip install：
       numpy open3d scipy flask pyserial -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
