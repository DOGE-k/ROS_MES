# ============================================================
# ROS MES 前端环境配置文件
# 部署到新机器时：
#   - 开发环境：复制为 ros_mes_front/.env.development
#   - 生产环境：复制为 ros_mes_front/.env.production
# ============================================================

# ---- 后端 API 地址 ----
# 开发环境使用本地代理，指向 FastAPI 后端地址
# 部署到局域网时修改为后端服务器 IP
VITE_API_TARGET=http://127.0.0.1:8000

# ---- 调试模式 ----
# 是否使用 Mock 数据（无后端时前端模拟）
VITE_USE_MOCK=false

# 无 ROS 调试模式：true 时模块下发、目标图纸下发、微调、设备/图纸列表走前端模拟数据
# 正式连接 ROS 环境时设为 false
VITE_DEBUG_NO_ROS=false

# ---- WebSocket 配置 ----
# 机器人状态 WebSocket 地址
VITE_WS_ROBOT_STATUS=ws://127.0.0.1:8000/api/ws/ws/robot_status

# 微调反馈 WebSocket 地址
VITE_WS_FEEDBACK=ws://127.0.0.1:8000/api/control/feedback/ws

# ---- rosbridge 直连配置（可选） ----
# 前端直接连接 rosbridge 的 WebSocket 地址
# 留空则通过后端代理转发
VITE_ROSBRIDGE_URL=
