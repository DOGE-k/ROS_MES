# ============================================================
# ROS MES 前端环境配置文件（V1.1）
# 部署到新机器时：
#   - 开发环境：复制为 mes_web/ros_mes_front/.env.development
#   - 生产环境：复制为 mes_web/ros_mes_front/.env.production
# ============================================================

# ---- 后端 API 地址 ----
# Vite 开发服务器把 /api 代理到该地址。
# 前后端同机保持 127.0.0.1；后端在另一台机器时改成 http://<后端IP>:8000
VITE_API_TARGET=http://127.0.0.1:8000

# ---- 前端整页 Mock（可选）----
# 仅在完全没有后端、只想看页面时设为 true。
# 正常的无 ROS 联调不要开这个：请在「个人中心 → 调试设置」选择模拟连接，
# 由后端运行期配置控制 ROS/图纸数据源，前端仍走真实 HTTP/WS。
VITE_USE_MOCK=false

# 说明：V1.0 的 VITE_DEBUG_NO_ROS / VITE_WS_* / VITE_ROSBRIDGE_URL 已废弃。
# WebSocket 反馈统一经后端 /api/control/feedback/ws 转发；rosbridge 只由后端连接。
