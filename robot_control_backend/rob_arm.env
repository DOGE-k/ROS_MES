# ======================================================================
#  ROS MES 硬件/运动参数  rob_arm.env （V2）
#  CAN 2.0B / 500kbps / 29 位扩展帧 / 大端序
#  位置量：绝对角度（0.01°, int32）；不再使用编码器计数
# ======================================================================

# ====================== 运动学参数（V2） ======================
# 摆动角软限位：±15°（V1.1 为 ±20°，V2 收紧）
MAX_SWING_ANGLE=15.0
# 注：伸缩限位以「逆运算节点参数」段 MIN_LENGTH_MM/MAX_LENGTH_MM 为准；
#     臂展范围以「最优点选取」段 ARM_MIN_EXTEND/ARM_MAX_EXTEND 为准（勿重复定义）


# ====================== V2 CAN 总线配置 ======================
CAN_CHANNEL=can0
CAN_BITRATE=500000
# 模块数（SEG 字段，0=默认模块）
CAN_MODULE_COUNT=1
# 节点数：1 主控 + 20 驱动节点地址（5臂×4轴ID布局，现用15轴）
CAN_NODE_COUNT=21
# 每模块轴数（4轴ID布局，20个地址，J3空置预留，现用15轴）
CAN_AXIS_COUNT=20
CAN_EFF_FLAG=0x80000000
CAN_RTR_FLAG=0x20000000
# 绝对角度命令默认速度限制（0.01°/s，0=不限制）
CAN_DEFAULT_SPEED_LIMIT=0

# ====================== V2 标识符递增量 ======================
# 轴号 +1 ⇒ ID + 0x100；节点号 +1 ⇒ ID + 0x2000；模块号 +1 ⇒ ID + 0x40000
CAN_AXIS_STEP=0x00000100
CAN_NODE_STEP=0x00002000
CAN_MODULE_STEP=0x00040000

# ====================== V2 类级过滤掩码 ======================
# PRI+GRP+SEG+NODE（不比较寻址单元与消息号）
CAN_CLASS_MASK=0x1FFFE000
# 全总线安全/系统组掩码（只看 PRI+GRP）
CAN_SYSTEM_MASK=0x1FC00000

# ====================== V2 总线负载上限 ======================
CAN_BUS_LOAD_LIMIT=60

# ====================== V2 基准/回零配置 ======================
CAN_HOME_ON_POWERUP=false
CAN_HOME_TIMEOUT=30.0
# 到位容差（0.01°，默认 100 即 1.0°）
CAN_DEFAULT_TOLERANCE=100

# ====================== V2 ROS 层 device_id 编码规则 ======================
# device_id 直接等于 CAN ID 的 AXIS 寻址单元（不再使用 node*100+axis 复合编码）
# 0：系统级指令（急停/急停解除/模块安全停）
# 轴号 1~20：4轴ID布局（每臂4个axis，J1旋转/J2摆动/J3空置/J4伸缩），臂号=⌈轴号/4⌉
#   臂1: 轴1旋转/2摆动/3空置/4伸缩 → device_id 1/2/3/4（3为J3空置，不下发）
#   臂2: 轴5~8                       → device_id 5..8
#   ...
#   臂5: 轴17~20                     → device_id 17..20
# 臂级传感器寻址单元 21~25：
#   臂1: device_id 21，臂2: 22，... 臂5: 25（臂号=device_id-20）
# 例外：节点级报文（心跳，AXIS=0）的 device_id 填 CAN NODE 号
# 下行帧 NODE 段恒填主控节点号，AXIS 段填 device_id（1~25）
CAN_MASTER_NODE_ID=1
# 系统级指令 device_id（急停/急停解除/模块安全停）
CAN_DEVICE_ID_SYSTEM=0
# SQLite 数据库路径（相对路径以节点工作目录为基准）
DB_PATH=ros_database.db
# 伸缩轴丝杠导程（mm/转）：1mm = 360/MM_PER_REV 度
MM_PER_REV=0.7

# ====================== V2 传感器臂级配置 ======================
# 臂级传感器寻址单元基址（21~25 对应臂1~5）
CAN_SENSOR_ARM_BASE=21
# 压力传感器所属臂（1~5）
PRESSURE_SENSOR_ARM=1
# RateIdx: 0=关闭, 1=10Hz, 2=压力50Hz/IMU20Hz
CAN_SENSOR_RATE_DEFAULT=1
# 压力上报单位换算（PressureRaw 的单位由嵌入式侧标定，此处系数待与嵌入式确认）
PRESSURE_G_TO_N=9.81

# ====================== V2 急停三级体系 ID ======================
# 全局急停：0x00000000；急停解除：0x00000004；模块安全停：0x00000008+模块偏移；单轴急停：0x0000210C+偏移
CAN_EMERGENCY_STOP_ID=0x00000000
CAN_RELEASE_STOP_ID=0x00000004
CAN_MODULE_STOP_ID=0x00000008
CAN_AXIS_STOP_ID=0x0000210C

# ====================== V2 心跳/看门狗 ======================
CAN_HEARTBEAT_PERIOD=0.1
CAN_HEARTBEAT_TIMEOUT=0.3
CAN_HEARTBEAT_MISS_CYCLES=3

# ====================== V2 IMU 原始 int16 → 物理量换算 ======================
IMU_GYRO_SCALE=0.0610330
IMU_ACC_SCALE=0.0047912
# V2：IMU 为臂级传感器，寻址单元 21~25 对应臂1~5
IMU_ARM_ADDRESS_BASE=21

# ====================== ROS 话题名称 ======================
ROS_TOPIC_ALL_FEEDBACK=/hardware/all_feedback
ROS_TOPIC_ARM_CMD_VEL=/arm/cmd_vel
ROS_TOPIC_ROTATION_OUTPUT=/hardware/rotation_output
ROS_TOPIC_SWING_OUTPUT=/hardware/swing_output
ROS_TOPIC_TELESCOPE_OUTPUT=/hardware/telescope_output
ROS_TOPIC_ROTATION_FEEDBACK=/hardware/rotation_feedback
ROS_TOPIC_SWING_FEEDBACK=/hardware/swing_feedback
ROS_TOPIC_TELESCOPE_FEEDBACK=/hardware/telescope_feedback
ROS_TOPIC_SENSOR_FEEDBACK=/hardware/sensor_feedback
ROS_TOPIC_SENSOR_RAW=/hardware/sensor_raw
ROS_TOPIC_MODULE_CMD=/control/module_cmd

# CAN 桥接原始转发话题（hardware_node → feedback_node）
ROS_TOPIC_CAN_ROTATION_RAW=/hardware/can/rotation_raw
ROS_TOPIC_CAN_SWING_RAW=/hardware/can/swing_raw
ROS_TOPIC_CAN_TELESCOPIC_RAW=/hardware/can/telescopic_raw
ROS_TOPIC_CAN_PRESSURE_RAW=/hardware/can/pressure_raw

# 功能节点统一订阅 _sequenced 话题（逆解 + 微调）
ROS_TOPIC_KINEMATICS_ROTATION_CMD_SEQ=/control/kinematics_rotation_cmd_sequenced
ROS_TOPIC_KINEMATICS_SWING_CMD_SEQ=/control/kinematics_swing_cmd_sequenced
ROS_TOPIC_KINEMATICS_TELESCOPIC_CMD_SEQ=/control/kinematics_telescopic_cmd_sequenced

# 控制节点输入话题
ROS_TOPIC_KINEMATICS_ROTATION_CMD_INPUT=/control/kinematics_rotation_cmd
ROS_TOPIC_KINEMATICS_SWING_CMD_INPUT=/control/kinematics_swing_cmd
ROS_TOPIC_KINEMATICS_TELESCOPIC_CMD_INPUT=/control/kinematics_telescopic_cmd
ROS_TOPIC_ADJUST_ROTATION_CMD_INPUT=/control/adjust_rotation_cmd
ROS_TOPIC_ADJUST_SWING_CMD_INPUT=/control/adjust_swing_cmd
ROS_TOPIC_ADJUST_TELESCOPIC_CMD_INPUT=/control/adjust_telescopic_cmd

# 模块确认成功/失败话题
ROS_TOPIC_MODULE_CONFIRM_SUCCESS=/hardware/module_confirm_success
ROS_TOPIC_MODULE_CONFIRM_FAILED=/hardware/web_module_cmd
ROS_TOPIC_SENSOR_CMD=/control/sensor_cmd

# ====================== V2 事件/状态话题 ======================
ROS_TOPIC_GYROSCOPE_FEEDBACK=/hardware/gyroscope_feedback
ROS_TOPIC_HEARTBEAT=/hardware/heartbeat
ROS_TOPIC_AXIS_STATUS=/hardware/axis_status
ROS_TOPIC_ARRIVE_NOTIFICATION=/hardware/arrive_notification
ROS_TOPIC_STOP_NOTIFICATION=/hardware/stop_notification
# V2 新增话题
ROS_TOPIC_CMD_ACK=/hardware/cmd_ack
ROS_TOPIC_HOME_STATUS=/hardware/home_status
ROS_TOPIC_AXIS_FAULT=/hardware/axis_fault
ROS_TOPIC_LIMIT_EVENT=/hardware/limit_event
ROS_TOPIC_VACUUM_LOSS=/hardware/vacuum_loss
ROS_TOPIC_POSITION_PACKED=/hardware/position_packed

# 急停话题
ROS_TOPIC_SOFTSTOP=/control/softstop
ROS_TOPIC_SOFTSTOP_RELEASE=/control/softstop_release
# V2 回零命令话题
ROS_TOPIC_HOME_CMD=/control/home_cmd

# 点云处理节点话题
ROS_TOPIC_FRONTEND_POINTCLOUD=/control/frontend_pointcloud_topic
ROS_TOPIC_MODULE_ARM_TASK=/module_arm_task
# 最优托举节点话题
ROS_TOPIC_ARM_ALPHA_BETA=/arm_alpha_beta
ROS_TOPIC_ARM_FUSION_STATS=/arm_fusion_stats
ROS_TOPIC_KINEMATICS_POSE=/control/kinematics_pose

# ====================== 时序控制参数 ======================
SENSOR_DELAY=7.0
CYCLE_INTERVAL=8.0

# ====================== 点云处理节点参数 ======================
MODULE_ORIGIN_X=0.0
MODULE_ORIGIN_Y=0.0
MODULE_ORIGIN_Z=0.0
MODULE_SIZE_X=10
MODULE_SIZE_Y=30
ARM_MIN_HEIGHT=10.0
ARM_SAFE_GAP=1.0

# ====================== （最优点选取）参数 ======================
VOXEL_SIZE=0.1
MAX_WORKERS=4
ARM_MIN_EXTEND=1.0
ARM_MAX_EXTEND=60.0
VERTICAL_CHECK_RADIUS=1.0
VERTICAL_FLAT_TOLERANCE=0.3
SURFACE_EXTRACT_K=20
SURFACE_ANGLE_THRESH=30.0
NORMAL_RADIUS=2.0
HORIZONTAL_ANGLE_THRESH=5.0
HORIZONTAL_Z_STD=0.5
DEFAULT_HEIGHT=11.0
MIN_POINTS_FOR_PCA=3
POINT_SELECT_STRATEGY=balanced
DISTANCE_WEIGHT=0.6
ANGLE_WEIGHT=0.4

# ====================== 逆运算节点参数 ======================
MIN_LENGTH_MM=50.0
MAX_LENGTH_MM=500.0
# V2 单次伸缩相对增量限幅（mm），kinematics_node 与 telescopic_node 共用
TELESCOPIC_MAX_DELTA_MM=50.0

# ====================== IMU陀螺仪节点参数 ======================
IMU_INITIAL_ROLL=0.0
IMU_INITIAL_PITCH=0.0
IMU_INITIAL_YAW=0.0
IMU_GRAVITY=9.81
IMU_ACCEL_UNIT_IS_G=False
IMU_KP=0.5
IMU_KI=0.05
IMU_ACC_TRUST_THRESH=1.0
IMU_BASE_X=0.0
IMU_BASE_Y=0.0
IMU_BASE_Z=0.0
IMU_SWING_CENTER_HEIGHT=30.0
IMU_TELESCOPIC_LENGTH=50.0
ROS_TOPIC_IMU_ANGLES=/hardware/imu_angles

# ====================== 模块确认（V2）参数 ======================
# 到位容差（0.01°，与 CAN_DEFAULT_TOLERANCE 对齐，默认 100=1.0°）
MODULE_CONFIRM_TOLERANCE=100
# 模块确认超时时间（秒）
MODULE_CONFIRM_TIMEOUT=15.0

# ====================== 压力传感器平均值计算参数 ======================
PRESSURE_SAMPLE_WINDOW=5.0
PRESSURE_SAMPLE_RATE=10
PRESSURE_WINDOW_SIZE=50
ROS_TOPIC_SENSOR_RAW=/hardware/sensor_raw
ROS_TOPIC_SENSOR_AVG=/hardware/sensor_feedback
ROS_TOPIC_PRESSURE_SAMPLE_TRIGGER=/control/pressure_sample_trigger
