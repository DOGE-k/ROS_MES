# ====================== 硬件转换参数 ======================
ENC_TO_DEG=0.01248
DEG_PER_TICK=0.01248
DEGREE_PER_TICK=0.01248
TELES_MM_PER_REV=0.7
MM_PER_REV=0.7
PRESSURE_MAX_ADC=16777215
PRESSURE_MAX_KG=10.0

# ====================== 编码器限位 ======================
ENC_MID=15000
ENC_MIN=580
ENC_MAX=29420

# ====================== 伸缩轴长度限制 ======================
MIN_LENGTH=0.0
MAX_LENGTH=150.0

# ====================== 模块与设备 ID ======================
MODULE_ID=17
TARGET_MODULE_ID=17
EMERGENCY_STOP_DEVICE_ID=1
DEV_ROTATE=41
DEV_SWING=42
DEV_TELES=43
DEV_SENSOR=49
# 以下设备控制 ID 已不再被功能节点使用（节点通过 device_id 自动识别），保留仅为兼容
DEV_ROTATE_CONTROL=33
DEV_SWING_CONTROL=34
DEV_TELES_CONTROL=35

# ====================== 串口配置 ======================
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# ====================== ROS 话题名称 ======================
ROS_TOPIC_ALL_FEEDBACK=/hardware/all_feedback
ROS_TOPIC_ROTATION_OUTPUT=/hardware/rotation_output
ROS_TOPIC_SWING_OUTPUT=/hardware/swing_output
ROS_TOPIC_TELESCOPE_OUTPUT=/hardware/telescope_output
ROS_TOPIC_ARM_CMD_VEL=/arm/cmd_vel
ROS_TOPIC_ROTATION_FEEDBACK=/hardware/rotation_feedback
ROS_TOPIC_SWING_FEEDBACK=/hardware/swing_feedback
ROS_TOPIC_TELESCOPE_FEEDBACK=/hardware/telescope_feedback
ROS_TOPIC_SENSOR_FEEDBACK=/hardware/sensor_feedback
ROS_TOPIC_MODULE_CMD=/hardware/module_cmd
ROS_TOPIC_KINEMATICS_POSE=/control/kinematics_pose

# 功能节点统一订阅以下三个 _sequenced 话题（包含逆解和微调指令）
ROS_TOPIC_KINEMATICS_ROTATION_CMD_SEQ=/control/kinematics_rotation_cmd_sequenced
ROS_TOPIC_KINEMATICS_SWING_CMD_SEQ=/control/kinematics_swing_cmd_sequenced
ROS_TOPIC_KINEMATICS_TELESCOPIC_CMD_SEQ=/control/kinematics_telescopic_cmd_sequenced

ROS_TOPIC_MODULE_CONFIRM_SUCCESS=/hardware/module_confirm_success
ROS_TOPIC_SENSOR_CMD=/control/sensor_cmd

# 以下微调话题已废弃，功能节点不再订阅（控制节点已统一话题）
# ROS_TOPIC_ADJUST_ROTATION_CMD=/control/adjust_rotation_cmd_sequenced
# ROS_TOPIC_ADJUST_SWING_CMD=/control/adjust_swing_cmd_sequenced
# ROS_TOPIC_ADJUST_TELESCOPIC_CMD=/control/adjust_telescopic_cmd_sequenced

# ====================== 控制节点订阅话题（输入） ======================
ROS_TOPIC_KINEMATICS_ROTATION_CMD_INPUT=/control/kinematics_rotation_cmd
ROS_TOPIC_KINEMATICS_SWING_CMD_INPUT=/control/kinematics_swing_cmd
ROS_TOPIC_KINEMATICS_TELESCOPIC_CMD_INPUT=/control/kinematics_telescopic_cmd

ROS_TOPIC_ADJUST_ROTATION_CMD_INPUT=/control/adjust_rotation_cmd
ROS_TOPIC_ADJUST_SWING_CMD_INPUT=/control/adjust_swing_cmd
ROS_TOPIC_ADJUST_TELESCOPIC_CMD_INPUT=/control/adjust_telescopic_cmd

# ====================== 时序控制参数 ======================
SENSOR_DELAY=7.0
CYCLE_INTERVAL=8.0

# ====================== 点云处理节点参数 ======================
MODULE_ORIGIN_X=0.0
MODULE_ORIGIN_Y=0.0
MODULE_ORIGIN_Z=0.0
MODULE_SIZE_X=10
MODULE_SIZE_Y=30
ARM_MIN_HEIGHT=10.0
ARM_SAFE_GAP=1.0

# 点云处理节点话题
ROS_TOPIC_FRONTEND_POINTCLOUD=/frontend_pointcloud_topic
ROS_TOPIC_MODULE_ARM_TASK=/module_arm_task


# ====================== （最优点选取）参数 ======================
VOXEL_SIZE=0.1
MAX_WORKERS=4
MAX_SWING_ANGLE=20.0
ARM_MIN_EXTEND=1.0
ARM_MAX_EXTEND=60.0
VERTICAL_CHECK_RADIUS=1.0
VERTICAL_FLAT_TOLERANCE=0.3
